DB_URL=DB_URL
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# OpenAI configs
MAX_TOKENS_PER_INPUT=8191
MAX_INPUTS_PER_BATCH=100
MULTIPART_CHUNK_SIZE=8388608

MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# --- Qdrant ---
# Local:  http://localhost:6333       (no API key)
# Cloud:  https://<cluster-id>.<region>.<provider>.cloud.qdrant.io:6333
QDRANT_DB_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Object storage (S3-compatible: MinIO / Cloudflare R2 / AWS S3) ---
# Local MinIO   : endpoint=minio:9000                              secure=false region=us-east-1 ensure_bucket=true
# Cloudflare R2 : endpoint=<ACCOUNT_ID>.r2.cloudflarestorage.com   secure=true  region=auto      ensure_bucket=false
# Endpoint is host[:port] only — no scheme; MINIO_SECURE controls http vs https.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdf-documents
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_ENSURE_BUCKET=true

REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1

# --- Internal service auth ---
# Same value must be configured in AI-Learning-Assistant-Service's own .env under the same name.
INTERNAL_SERVICE_KEY=

# --- Outbound webhook ---
AI_LEARNING_ASSISTANT_BASE_URL=http://localhost:8002
AI_LEARNING_ASSISTANT_WEBHOOK_PATH=/internal/webhooks/pdf-ingestion
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_DELAY=2.0